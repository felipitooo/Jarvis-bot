# ==========================================
# CELL DISCORD BOT - ENVIRONMENT CONFIGURATION
# ==========================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Application Environment (development | production | test)
NODE_ENV=development

# Web Panel Server Configuration
PORT=3000
WEB_HOST=127.0.0.1

# Database Configuration (Relative or absolute path to SQLite database)
DATABASE_PATH=./data/cell.sqlite

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# Global AI Default Identity
DEFAULT_AI_NAME=Cell

# AI Core Configuration (Gemini API - Optional for testing/mock mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
